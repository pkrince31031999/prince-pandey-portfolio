# Absolute site URL used for canonical and Open Graph metadata.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://princepandey.in
# Automatic contact-form delivery uses Resend (https://resend.com).
# Leave these empty to keep the mailto fallback. Do not commit real keys.
RESEND_API_KEY=
# A sender on a domain you have verified in Resend.
# Example: Prince Pandey <hello@your-domain.com>
CONTACT_FROM_EMAIL=
# Optional. Defaults to the public portfolio email.
CONTACT_TO_EMAIL=
